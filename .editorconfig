root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,asmdef}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[tests/**.cs]
# Test data is written inline; hoisting every array into a static field would make the tests harder to read.
dotnet_diagnostic.CA1861.severity = none
